{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprtam.cz/schema/vocab.schema.json",
  "title": "Šprtám – anglická slovíčka",
  "$comment": "Generováno z src/content/format.ts a src/widgets/ (npm run content:generate). Needitovat ručně.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Verze formátu, teď 1."
    },
    "level": {
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1"
      ],
      "description": "Úroveň podle SERR, stejná jako název souboru."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Název okruhu, např. \"Zvířata\"."
          },
          "emoji": {
            "type": "string",
            "minLength": 1,
            "description": "Jedno emoji okruhu."
          },
          "lang": {
            "enum": [
              "en-GB",
              "en-US",
              "en-AU"
            ],
            "description": "Přízvuk výslovnosti; výchozí en-GB."
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "$schema": {
                  "type": "string"
                },
                "cz": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Česky – na tohle se aplikace ptá."
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Správně anglicky. Musí být jedinečné napříč všemi úrovněmi (je na něm uložený pokrok)."
                },
                "similar": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Špatná možnost, která podobně vypadá nebo zní (bird → bard)."
                },
                "related": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Špatná možnost, která souvisí významem (bird → parrot)."
                }
              },
              "required": [
                "cz",
                "en",
                "similar",
                "related"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "emoji",
          "words"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Okruhy. Odkazují se pořadím (/slovicka/A1/0) – nové přidávej na konec."
    }
  },
  "required": [
    "format",
    "level",
    "groups"
  ],
  "additionalProperties": false,
  "description": "Anglická slovíčka jedné úrovně."
}
