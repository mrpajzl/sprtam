        {
          "type": "heading",
          "text": "O čem to je"
        },
        {
          "type": "text",
          "text": "Když říkáš básničku, můžeš k ní tleskat. Každé tlesknutí je jeden kousek slova."
        },
        {
          "type": "text",
          "text": "Dlouhé slovo se po kouscích lépe čte. A když píšeš a dojde řádek, víš, kde slovo rozdělit."
        },
        {
          "type": "term",
          "term": "Slabika",
          "definition": "Kousek slova, který řekneš najednou – na jedno tlesknutí.",
          "example": "MA-MA má dvě slabiky: MA a MA."
        },
        {
          "type": "picture",
          "items": [
            "👏",
            "👏"
          ],
          "caption": "MA – MA = 2 slabiky"
        },
