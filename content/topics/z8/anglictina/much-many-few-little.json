                "group": 1
              }
            ]
          }
        },
        {
          "type": "text",
          "text": "Pozor: *money* (peníze) je v angličtině nepočitatelné, i když mince spočítat jdou. Spočítat jdou *coins* (mince), ale *money* ne."
        },
        {
          "type": "heading",
          "text": "Slova pro každou krabici"
        },
        {
          "type": "table",
          "head": [
            "",
            "počitatelné",
            "nepočitatelné"
          ],
          "rows": [
            [
              "hodně (hlavně otázka a zápor)",
              "many cars",
