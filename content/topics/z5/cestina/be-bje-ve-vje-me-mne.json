                    "label": "příponová část"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Postup pro bje/vje"
        },
        {
          "type": "steps",
          "items": [
            "Je ve slově předpona **ob-** nebo **v-**?",
            "Začíná kořen za ní na **je-** (jet, jem, jev)?",
            "Obojí ano → **bje / vje**.",
            "Ne → **bě / vě**."
          ]
        },
        {
          "type": "example",
          "question": "Objet, nebo obět?",
          "answer": "Ob + **jet** (jet autem). Kořen začíná na je- → **objet**."
        },
        {
          "type": "example",
          "question": "Objehnout, nebo oběhnout?",
          "answer": "Ob + **běh** + nout. Kořen začíná na b, ne na je- → **oběhnout**."
        },
        {
          "type": "heading",
          "text": "A co mě, mně?"
        },
        {
          "type": "text",
          "text": "Ve slovech píšeme **mně** jen tehdy, když je **mn** v příbuzném slově: *zapomenout → zapomněl*, *jemný → jemně*. Jinde **mě**: *město, měsíc, změna*."
        },
        {
          "type": "mistake",
          "wrong": "zapoměl",
          "right": "zapomněl",
          "why": "Příbuzné slovo je *zapomenout* – je v něm **m-n**. Proto mně."
        },
        {
          "type": "summary",
          "text": "bje, vje jen na švu ob-/v- + je-. Jinak bě, vě. Mně ve slově jen tam, kde je mn v příbuzném slově."
        }
      ]
    },
    {
      "title": "Mě, nebo mně?",
      "blocks": [
        {
          "type": "heading",
          "text": "O čem to je"
        },
        {
          "type": "text",
          "text": "„Pojď ke mně.“ „Nikdo mě neviděl.“ Obě slova znějí stejně – „mňe“. Ale znamenají něco jiného, a tak se jinak píšou."
        },
        {
          "type": "text",
          "text": "Naučíš se jednoduchý trik s **tebe/tobě**. A zopakuješ si i *bje/vje*."
        },
        {
          "type": "term",
          "term": "Zájmeno já",
          "definition": "Slovo, kterým mluvíš o sobě. V různých pádech má různé tvary.",
          "example": "já, mě, mně, mnou"
        },
        {
          "type": "term",
          "term": "Pád",
          "definition": "Připomenutí: tvar slova podle otázky (2. bez koho, 3. komu, 4. koho/co, 6. o kom).",
          "example": "bez mě (2.), ke mně (3.)"
        },
        {
          "type": "term",
          "term": "Trik tebe/tobě",
          "definition": "Místo já řekni tvar od ty. Hodí se **tebe** → napiš **mě**. Hodí se **tobě** → napiš **mně**.",
          "example": "bez tebe → bez mě; k tobě → ke mně"
        },
        {
          "type": "table",
          "head": [
            "píšu",
            "kdy",
            "příklad"
          ],
