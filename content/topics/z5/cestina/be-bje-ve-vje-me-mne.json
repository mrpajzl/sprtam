  "explanations": [
    {
      "title": "Šev mezi díly",
      "blocks": [
        {
          "type": "heading",
          "text": "O čem to je"
        },
        {
          "type": "text",
          "text": "Řekni *objet* a *oběd*. Zní skoro stejně: „objet“, „objed“. A přesto jedno píšeme s **bje** a druhé s **bě**."
        },
        {
          "type": "text",
          "text": "Rozdíl je ve stavbě slova. Kde se potkají dva díly, je **šev** – a právě tam se píše *bje* nebo *vje*. Podobně u *mě* a *mně* rozhoduje, z čeho slovo vzniklo."
        },
        {
          "type": "heading",
          "text": "Nové pojmy"
        },
        {
          "type": "term",
          "term": "Předpona a kořen",
          "definition": "Připomenutí: předpona je část před kořenem, kořen je společný pro příbuzná slova.",
          "example": "**ob** + **jet** = objet"
        },
        {
          "type": "term",
          "term": "Šev",
          "definition": "Místo, kde předpona končí a kořen začíná.",
          "example": "ob|jet, v|jezd"
        },
        {
          "type": "term",
          "term": "bje, vje",
          "definition": "Píšeme jen na švu: předpona **ob-** nebo **v-** + kořen, který začíná na **je-**.",
          "example": "objet, objem, objevit, vjet, vjezd"
        },
        {
          "type": "term",
          "term": "bě, vě",
          "definition": "Píšeme všude jinde.",
          "example": "oběd, oběhnout, běhat, věc, květ"
        },
        {
          "type": "widget",
          "widget": "parts",
          "props": {
            "words": [
              {
                "parts": [
                  {
                    "text": "ob",
                    "label": "předpona"
                  },
