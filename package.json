{
  "name": "sprtam",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr",
    "preview": "vite preview",
    "check:content": "tsx scripts/check-content.ts",
    "content:generate": "tsx scripts/content-generate.ts",
    "content:format": "tsx scripts/content-format.ts",
    "moderator:dev": "node moderator/dev.mjs",
    "moderator:build": "tsc --noEmit -p moderator && vite build --config moderator/vite.config.ts && vite build --ssr --config moderator/vite.config.ts",
    "start": "node dist-server/index.mjs",
    "content:pull": "tsx scripts/content-pull.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "preact": "^11.0.2",
    "qr-scanner": "^1.4.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
